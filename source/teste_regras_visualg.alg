algoritmo "teste_regras"
var
   x: inteiro
inicio
   escreval("1) e antes de ou: ", verdadeiro ou falso e falso)
   escreval("2) valor inicial: [", x, "]")
   escreval("3) espaco antes de numero: [", 7, "]")
   escreval("4) div e barra: ", 7 div 2, " ", 7 \ 2)
   escreval("5) real: ", 7 / 2, " ", 10 / 2)
fimalgoritmo
